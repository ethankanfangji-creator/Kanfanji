# Template — safe to commit. Fill real values in:
#   .env.local          → kanfangji-dev (local / Preview)
#   .env.production     → kanfangji-prod (Production)  [gitignored]
#   Vercel Dashboard    → Production + Preview env vars
#
# See docs/STACK.md for which vars are public vs server-only.
# Never put OPENAI_*, STRIPE_SECRET_*, SERVICE_ROLE, or cookie secrets in NEXT_PUBLIC_*.

# --- Public (browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional public support inbox for Contact support (mailto)
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase server ---
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (server only) ---
OPENAI_API_KEY=
AI_GUEST_COOKIE_SECRET=
AI_QUOTA_HASH_SECRET=
# AI_UPSTREAM_TIMEOUT_MS=45000
# AI_GUEST_DAILY_LIMIT=
# AI_DEVICE_DAILY_LIMIT=
# AI_IP_DAILY_LIMIT=
# AI_USER_DAILY_LIMIT=
# AI_QUOTA_WINDOW_SECONDS=

# --- Property intel (server only, optional) — managed via config/property-providers.ts ---
# Without these keys, chat still works; enrich notes explain missing_key vs stub_only.
# Google Geocoding + Places Nearby + Distance Matrix + Street View Static
GOOGLE_MAPS_API_KEY=
# Bing Web Search v7 — snippets only (public_web). Never scrapes destination pages.
BING_SEARCH_API_KEY=
# Optional US licensed property profile (ATTOM Data)
# ATTOM_API_KEY=
# Shared DB cache TTL hours (default 168 = 7 days) — must not exceed provider retentionHours
# PROPERTY_INTEL_CACHE_TTL_HOURS=168
# Property report snapshot TTL (defaults to PROPERTY_INTEL_CACHE_TTL_HOURS)
# PROPERTY_REPORT_TTL_HOURS=168
# PROPERTY_REPORT_TIMEOUT_MS=60000
# Force in-memory report store (tests / local without DB)
# PROPERTY_REPORT_MEMORY_STORE=1

# --- Optional MLS (stub only until licensed adapter is wired; never scrape) ---
# CREA_DDF_CLIENT_ID=
# CREA_DDF_CLIENT_SECRET=

# --- Share cookies (server only) ---
SHARE_COOKIE_SECRET=

# --- Stripe (server only) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Billing Portal uses STRIPE_SECRET_KEY + NEXT_PUBLIC_SITE_URL
# (enable Customer portal in Stripe Dashboard; test/live separately).
