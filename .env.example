# Template — safe to commit. Fill real values in:
#   .env.local          → kanfangji-dev (local / Preview)
#   .env.production     → kanfangji-prod (Production)  [gitignored]
#   Vercel Dashboard    → Production + Preview env vars
#
# See docs/STACK.md for which vars are public vs server-only.
# Never put OPENAI_*, STRIPE_SECRET_*, SERVICE_ROLE, or cookie secrets in NEXT_PUBLIC_*.

# --- Public (browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase server ---
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (server only) ---
OPENAI_API_KEY=
AI_GUEST_COOKIE_SECRET=
AI_QUOTA_HASH_SECRET=
# AI_UPSTREAM_TIMEOUT_MS=45000
# AI_GUEST_DAILY_LIMIT=
# AI_DEVICE_DAILY_LIMIT=
# AI_IP_DAILY_LIMIT=
# AI_USER_DAILY_LIMIT=
# AI_QUOTA_WINDOW_SECONDS=

# --- Property intel (server only, optional) ---
# Google Geocoding + Places Nearby + Street View Static
GOOGLE_MAPS_API_KEY=
# Bing Web Search v7 — snippets only for Assessment / realtor / 實價登錄 (no crawling)
BING_SEARCH_API_KEY=
# Optional US property profile (ATTOM Data)
# ATTOM_API_KEY=
# Shared DB cache TTL hours (default 168 = 7 days) — cuts repeat Google/Bing spend
# PROPERTY_INTEL_CACHE_TTL_HOURS=168

# --- Share cookies (server only) ---
SHARE_COOKIE_SECRET=

# --- Stripe (server only) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Optional MLS ---
# CREA_DDF_CLIENT_ID=
# CREA_DDF_CLIENT_SECRET=
